package c

import bait.ast
import bait.errors

fun (mut g Gen) gen_equality_funs() {
	for typ in g.table.needed_equality_funs {
		_ = g.equality_fun(typ)
	}
}

fun (mut g Gen) equality_fun(typ ast.Type) string {
	sym := g.table.get_sym(typ)
	if g.generated_eq_funs.contains(typ) {
		return c_esc('${sym.mix_name}_eq')
	}

	if sym.kind == .number or sym.kind == .other {
		// Simple builtin types have this type. They don't need an equality function
		return ''
	}

	// Enums can use normal == and !=
	if sym.kind == .enum_ {
		return ''
	}

	// Equality is manually defined as overload
	if sym.overloads.contains('==') {
		overload := sym.overloads['==']
		return c_esc(sym.mix_name + '_' + overload.name)
	}

	// Generics types don't need an equality function
	if sym.kind == .generic {
		return ''
	}

	if sym.kind == .array {
		g.generated_eq_funs.push(typ)

		info := sym.info as ast.ArrayInfo
		sname := c_esc(sym.mix_name)
		fname := c_esc('${sym.mix_name}_eq')
		elem_type_str := g.typ(info.elem_type)

		g.fun_decls_out.write('bool ${fname}(${sname} a, ${sname} b);\n')

		g.auto_funs_out.write('bool ${fname}(${sname} a, ${sname} b) {\n')

		// Compare length
		g.auto_funs_out.write('\tif (a.length != b.length) {\n')
		g.auto_funs_out.write('\t\treturn false;\n')
		g.auto_funs_out.write('\t}\n')

		// Compare elements
		elem_eq_fun := g.equality_fun(info.elem_type)
		g.auto_funs_out.write('\tfor (int i = 0; i < a.length; i++) {\n')
		if elem_eq_fun.length > 0 {
			g.auto_funs_out.write('\t\tif (!${elem_eq_fun}(*(${elem_type_str}*)Array_get(a, i), *(${elem_type_str}*)Array_get(b, i))) {\n')
		} else {
			g.auto_funs_out.write('\t\tif (*(${elem_type_str}*)Array_get(a, i) != *(${elem_type_str}*)Array_get(b, i)) {\n')
		}
		g.auto_funs_out.write('\t\t\treturn false;\n')
		g.auto_funs_out.write('\t\t}\n')

		g.auto_funs_out.write('\t}\n')
		g.auto_funs_out.write('\treturn true;\n')
		g.auto_funs_out.write('}\n\n')

		return fname
	}

	if sym.kind == .sum_type {
		return g.sum_equality_fun(typ, sym)
	}

	if sym.kind == .struct_ {
		return g.struct_equality_fun(typ, sym)
	}

	if sym.kind == .alias_type {
		return g.equality_fun(sym.parent)
	}

	if sym.kind == .fun_ {
		return ''
	}

	errors.generic_error('cannot generate equality function for type ${sym.mix_name}')
	exit(1)
}

// Compare two values of `typ` given as C expressions
fun (mut g Gen) eq_check(typ ast.Type, a string, b string) string {
	if typ.get_nr_amp() > 0 {
		return '${a} == ${b}'
	}

	eq_fun := g.equality_fun(typ)
	if eq_fun.length > 0 {
		return '${eq_fun}(${a}, ${b})'
	}
	return '${a} == ${b}'
}

fun (mut g Gen) sum_equality_fun(typ ast.Type, sym ast.TypeSymbol) string {
	g.generated_eq_funs.push(typ)

	info := sym.info as ast.SumTypeInfo
	sname := c_esc(sym.mix_name)
	fname := c_esc('${sym.mix_name}_eq')

	g.fun_decls_out.write('bool ${fname}(${sname} a, ${sname} b);\n')

	mut cases := ''
	for var in info.variants {
		a := '*' + g.sum_field(typ, 'a', var)
		b := '*' + g.sum_field(typ, 'b', var)
		cases += '\t\tcase ${var.idx()}: return ${g.eq_check(var, a, b)};\n'
	}

	g.auto_funs_out.write('bool ${fname}(${sname} a, ${sname} b) {\n')
	g.auto_funs_out.write('\tif (a.typ != b.typ) {\n')
	g.auto_funs_out.write('\t\treturn false;\n')
	g.auto_funs_out.write('\t}\n')
	g.auto_funs_out.write('\tswitch (a.typ) {\n')
	g.auto_funs_out.write(cases)
	g.auto_funs_out.write('\t}\n')
	g.auto_funs_out.write('\treturn true;\n')
	g.auto_funs_out.write('}\n\n')

	return fname
}

fun (mut g Gen) struct_equality_fun(typ ast.Type, sym ast.TypeSymbol) string {
	g.generated_eq_funs.push(typ)

	info := sym.info as ast.StructInfo
	sname := c_esc(sym.mix_name)
	fname := c_esc('${sym.mix_name}_eq')

	g.fun_decls_out.write('bool ${fname}(${sname} a, ${sname} b);\n')

	mut checks := ''
	for field in info.fields {
		name := c_esc(field.name)
		check := g.eq_check(field.typ, 'a.${name}', 'b.${name}')
		checks += '\tif (!(${check})) {\n\t\treturn false;\n\t}\n'
	}

	g.auto_funs_out.write('bool ${fname}(${sname} a, ${sname} b) {\n')
	g.auto_funs_out.write(checks)
	g.auto_funs_out.write('\treturn true;\n')
	g.auto_funs_out.write('}\n\n')

	return fname
}
