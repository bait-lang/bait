package c

import strings
import bait.preference
import bait.ast
import bait.errors

struct Gen {
	pref preference.Prefs
	table ast.Table
	mut path string
	mut pkg string
	mut main_inits_out strings.Builder
	mut type_defs_out strings.Builder
	mut fun_decls_out strings.Builder
	mut type_impls_out strings.Builder
	mut auto_funs_out strings.Builder
	mut globals_out strings.Builder
	mut out strings.Builder
	mut indent i32 := -1
	mut empty_line bool := true
	mut stmt_offsets []i32
	mut foreign_imports []string // C header files
	mut generated_eq_funs []ast.Type
	mut generated_str_funs []ast.Type
	mut tmp_counter i32
	mut loop_label_names []string
	mut loop_continue_targets []string
	mut cur_concrete_types map[string]ast.Type
	mut cur_fun ast.FunDecl
	mut is_lhs_assign bool
	mut is_array_map_set bool
	mut is_for_loop_head bool
	// Cached comptime variables
	mut baitexe string
	mut baitdir string
	mut baithash string
}

pub fun gen(files []ast.File, table ast.Table, pref preference.Prefs) string {
	mut g := Gen{
		pref = pref
		table = table
		indent = -1
		empty_line = true
		main_inits_out = strings.new_builder(100)
		type_defs_out = strings.new_builder(100)
		fun_decls_out = strings.new_builder(100)
		type_impls_out = strings.new_builder(100)
		auto_funs_out = strings.new_builder(100)
		globals_out = strings.new_builder(100)
		out = strings.new_builder(1000)
	}

	g.write_types()
	g.gen_equality_funs()

	for file in files {
		g.path = file.path
		g.pkg = file.pkg_name

		g.process_imports(file.imports)
		g.stmts(file.stmts)
		g.out.write("\n")
	}

	if not g.pref.is_library {
		g.c_main()
	}

	// Auto string functions
	for typ in g.table.needed_str_funs {
		g.generate_str_fun(typ)
	}

	// Join all parts
	return g.headers() + g.type_defs_out.str() + g.fun_decls_out.str() + g.type_impls_out.str() + g.auto_funs_out.str() + g.globals_out.str() + '\n' + g.out.str()
}

fun (g Gen) process_imports(imports []ast.Import) {
	for imp in imports {
		// TODO handle alias clash
		if imp.lang == .bait or g.foreign_imports.contains(imp.name) {
			continue
		}
		g.foreign_imports.push(imp.name)
	}
}

fun (g Gen) headers() string {
	mut headers := strings.new_builder(100)
	headers.write('// Headers and includes\n')
	for name in g.foreign_imports {
		headers.write('#include <${name}>\n')
	}
	headers.write('\n')
	return headers.str()
}

fun (mut g Gen) c_main() {
	g.writeln('int main(int argc, char* argv[]) {')
	g.writeln(g.main_inits_out.str())
	if not g.pref.is_script {
		g.writeln('\tbait_main();')
	}
	g.writeln('\treturn 0;')
	g.writeln('}')
}


fun (g Gen) get_concrete_name(name string, concrete_types []ast.Type) string {
	mut full_name := name
	for t in concrete_types {
		full_name += '_' + g.table.get_sym(t).mix_name
	}
	return c_esc(full_name)
}

fun (mut g Gen) tmp_var() {
	g.write("_t${g.tmp_counter}")
}

fun (mut g Gen) new_temp_var() string {
	g.tmp_counter += 1
	return '_t${g.tmp_counter}'
}

fun (mut g Gen) write_indent() {
	if g.indent > 0 and g.empty_line {
		g.out.write('\t'.repeat(g.indent))
	}
}

fun (mut g Gen) write(s string){
	g.write_indent()
	g.out.write(s)
	g.empty_line = false
}

fun (mut g Gen) writeln (s string){
	g.write_indent()
	g.out.write(s)
	g.out.write("\n")
	g.empty_line = true
}

fun (mut g Gen) cut_before(to u8) string {
	for i := g.out.length - 1; i >= 0; i -= 1 {
		if g.out.at(i) == to {
			cut := g.out.substr(i + 1, g.out.length)
			g.out.truncate(i)
			return cut
		}
	}
	return g.out.substr(0, g.out.length)
}

fun (mut g Gen) cut_before_any(chars string) string {
	for i := g.out.length - 1; i >= 0; i -= 1 {
		for c in chars {
			if g.out.at(i) == c {
				cut := g.out.substr(i + 1, g.out.length)
				g.out.truncate(i)
				return cut
			}
		}
	}
	return g.out.substr(0, g.out.length)
}

fun (mut g Gen) cut_back_to(pos i32) string {
	cut := g.out.substr(pos, g.out.length)
	g.out.truncate(pos)
	return cut
}

fun (mut g Gen) save_stmt_offset() {
	g.stmt_offsets.push(g.out.length)
}

fun c_name(n string) string {
	return n.replace('.', '__').replace('[]', 'Array_').replace('[', '_').replace(']', '_')
}

fun c_esc(n string) string {
	name := c_name(n)
	if is_reserved(name) {
		return 'bait_${name}'
	}
	return name
}
