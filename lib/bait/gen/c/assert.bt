package c

import bait.ast
import bait.util.escape

fun (mut g Gen) assert_stmt(node ast.AssertStmt) {
	// Note: non-test assert is handled by transformer

	g.save_stmt_offset()
	if has_printable_sides(node.expr) {
		g.assert_infix(node)
		return
	}

	g.write('if (')
	g.expr(node.expr)
	g.writeln(') {')
	g.writeln('\tTestRunner_pass(&builtin__test_runner);')
	g.writeln('} else {')
	g.write('\tTestRunner_fail(&builtin__test_runner, ${node.pos.line}, from_c_string("assert ')
	g.assert_side_expr(node.expr)
	g.writeln('"));')
	g.writeln('}')
}

// Generate each side once, as or-blocks cannot be declared twice
fun (mut g Gen) assert_infix(node ast.AssertStmt) {
	expr := node.expr as ast.InfixExpr
	short_circuit := expr.op == .key_and or expr.op == .key_or
	mut left := expr.left
	mut right := expr.right
	if not short_circuit {
		left = g.assert_tmp(expr.left, expr.left_type)
		right = g.assert_tmp(expr.right, expr.right_type)
	}

	new_infix := ast.InfixExpr{
		left = left
		left_type = expr.left_type
		op = expr.op
		right = right
		right_type = expr.right_type
	}
	g.write('if (')
	g.expr(new_infix)
	g.writeln(') {')
	g.writeln('\tTestRunner_pass(&builtin__test_runner);')
	g.writeln('} else {')
	g.write('\tTestRunner_fail_infix(&builtin__test_runner, ${node.pos.line}, from_c_string("assert ')
	g.assert_side_expr(expr.left)
	g.write(' ${expr.op.c_repr()} ')
	g.assert_side_expr(expr.right)
	g.write('"), ')
	g.expr_to_string(left, expr.left_type)
	g.write(', ')
	g.expr_to_string(right, expr.right_type)
	g.writeln(');')
	g.writeln('}')
}

fun (mut g Gen) assert_tmp(expr ast.Expr, typ ast.Type) ast.Expr {
	tmp := g.new_temp_var()
	g.write('${g.typ(typ)} ${tmp} = ')
	g.expr(expr)
	g.writeln(';')
	g.save_stmt_offset()
	return ast.Ident{ name = tmp }
}

fun has_printable_sides(expr ast.Expr) bool {
	if expr is ast.InfixExpr {
		// The right side of `is` is a type
		return expr.op != .key_is
	}
	return false
}

fun (mut g Gen) assert_side_expr(node ast.Expr) {
	if node is ast.BoolLiteral {
		g.bool_literal(node)
	} else if node is ast.IntegerLiteral {
		g.integer_literal(node)
	} else if node is ast.InfixExpr {
		g.assert_side_expr(node.left)
		g.write(' ')
		g.write(node.op.c_repr())
		g.write(' ')
		g.assert_side_expr(node.right)
	} else if node is ast.PrefixExpr {
		g.write(node.op.c_repr())
		g.assert_side_expr(node.right)
	} else if node is ast.ParExpr {
		g.write('(')
		g.assert_side_expr(node.expr)
		g.write(')')
	} else if node is ast.AsCast {
		g.write('(')
		g.assert_side_expr(node.expr)
		g.write(' as ')
		g.write(g.table.type_name(node.target))
		g.write(')')
	} else if node is ast.StringLiteral {
		g.write("'")
		g.write(escape.linebreak(node.val))
		g.write("'")
	} else if node is ast.CharLiteral {
		g.write("`")
		g.write(node.val)
		g.write("`")
	} else if node is ast.ArrayInit {
		g.write('[')
		for i, expr in node.exprs {
			g.assert_side_expr(expr)
			if i < node.exprs.length - 1 {
				g.write(', ')
			}
		}
		g.write(']')
	} else if node is ast.Ident {
		g.write(node.full_name())
	} else if node is ast.ArrayInit {
		g.write('[')
		for i, expr in node.exprs {
			g.assert_side_expr(expr)
			if i < node.exprs.length - 1 {
				g.write(', ')
			}
		}
		g.write(']')
	} else if node is ast.IndexExpr {
		g.assert_side_expr(node.left)
		g.write('[')
		g.assert_side_expr(node.index)
		g.write(']')
	} else if node is ast.SelectorExpr {
		g.assert_side_expr(node.expr)
		g.write('.${node.field_name}')
	} else if node is ast.ComptimeVar {
		g.write('$')
		g.write(node.kind.str())
	} else {
		g.write('UNHANDLED EXPR')
	}
}
