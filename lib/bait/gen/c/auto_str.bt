package c

import os
import bait.ast
import bait.errors

const LB := if os.platform() == 'windows' { '\\r\\n' } else { '\\n' }

fun (mut g Gen) get_str_fun(typ ast.Type) string {
	conc := g.concrete_type(typ).set_nr_amp(0)
	g.table.needed_str_funs.push(conc)
	sym := g.table.get_sym(conc)
	return c_esc('${sym.mix_name}_str')
}

// Whether the generated str fun of `typ` is multiline and has to be indented when nested.
// JS passes an indent to the str funs, the C ones indent the finished string instead.
fun (g Gen) str_needs_indent(typ ast.Type) bool {
	sym := g.table.get_sym(typ.set_nr_amp(0))
	if sym.has_method('str') {
		return false
	}
	if sym.kind == .alias_type {
		return g.str_needs_indent(sym.parent)
	}
	return sym.kind == .struct_ or sym.kind == .generic_inst or sym.kind == .array or sym.kind == .sum_type
}

// C expression of `val` (a string), indented by one level if needed
fun (g Gen) indent_str(typ ast.Type, val string) string {
	if g.str_needs_indent(typ) {
		return 'string_replace(${val}, from_c_string("\\n"), from_c_string("\\n  "))'
	}
	return val
}

// TODO transformer?
fun (mut g Gen) generate_str_fun(ptr_typ ast.Type) {
	typ := ptr_typ.set_nr_amp(0)
	sym := g.table.get_sym(typ)
	if g.generated_str_funs.contains(typ) {
		return
	}

	if sym.has_method('str') {
		return
	}

	// Generic types are generated for their concrete types
	if g.has_generic(typ) {
		return
	}

	g.generated_str_funs.push(typ)

	sname := c_esc(sym.mix_name)
	fname := sname + '_str'

	if sym.kind == .array {
		info := sym.info as ast.ArrayInfo
		elem_type_str := g.typ(info.elem_type)
		el_str := g.get_str_fun(info.elem_type)
		el_call := g.indent_str(info.elem_type, '${el_str}(*(${elem_type_str}*)Array_get(a, i))')

		g.fun_decls_out.write('string ${fname}(${sname} a);\n')

		g.auto_funs_out.write('string ${fname}(${sname} a) {
	strings__Builder b = strings__new_builder(100);
	strings__Builder_write(&b, from_c_string("["));
	for (int i = 0; i < a.length; i++) {
		string el = ${el_call};
		strings__Builder_write(&b, el);
		if (i < a.length - 1) {
			strings__Builder_write(&b, from_c_string(", "));
		}
	}
	strings__Builder_write_u8(&b, \']\');
	return strings__Builder_str(&b);
}\n\n')
		return
	}

	if sym.kind == .struct_ or sym.kind == .generic_inst {
		fields := g.struct_fields(typ)

		g.fun_decls_out.write('string ${fname}(${sname} it);')

		g.auto_funs_out.write('string ${fname}(${sname} it) {
	int indent = 0;
	string space = string_repeat(from_c_string(" "), indent * 2);
	strings__Builder b = strings__new_builder(100);
	strings__Builder_write(&b, space);
	strings__Builder_write(&b, from_c_string("${sym.mix_name}{"));\n')
		if fields.length > 0 {
			g.auto_funs_out.write('\tstrings__Builder_write(&b, from_c_string("${LB}"));\n')
		}
		for field in fields {
			if typ == field.typ {
				g.auto_funs_out.write('\tstrings__Builder_write(&b, space);
	strings__Builder_write(&b, from_c_string("  ${field.name} = ${sym.mix_name}{...}${LB}"));\n')
				continue
			}

			str_fun_name := g.get_str_fun(field.typ)
			field_call := g.indent_str(field.typ, '${str_fun_name}(it.${c_esc(field.name)})')
			// TODO pass indent to str fun if needed
			g.auto_funs_out.write('\tstrings__Builder_write(&b, space);
	strings__Builder_write(&b, from_c_string("  ${field.name} = "));
	strings__Builder_write(&b, ${field_call});
	strings__Builder_write(&b, from_c_string("${LB}"));\n')
		}

		g.auto_funs_out.write('\tstrings__Builder_write(&b, space);
	strings__Builder_write_u8(&b, \'}\');
	return strings__Builder_str(&b);
}\n\n')
		return
	}

	if sym.kind == .sum_type {
		info := sym.info as ast.SumTypeInfo

		g.fun_decls_out.write('string ${fname}(${sname} it);\n')

		mut cases := ''
		for var in info.variants {
			val := g.sum_field(typ, 'it', var)
			if g.table.get_sym(var).kind == .string {
				cases += '\t\tcase ${var.idx()}: return *${val};\n'
			} else {
				cases += '\t\tcase ${var.idx()}: return ${g.get_str_fun(var)}(*${val});\n'
			}
		}
		g.auto_funs_out.write('string ${fname}(${sname} it) {
	switch (it.typ) {
${cases}	}
	return from_c_string("");
}\n\n')
		return
	}

	if sym.kind == .enum_ {
		info := sym.info as ast.EnumInfo
		type_str := g.typ(typ)

		g.fun_decls_out.write('string ${fname}(${type_str} it);\n')

		mut cases := ''
		for val in info.vals {
			cases += '\t\tcase ${enum_val_name(sym.mix_name, val)}: return from_c_string("${val}");\n'
		}
		g.auto_funs_out.write('string ${fname}(${type_str} it) {
	switch (it) {
${cases}	}
	return from_c_string("");
}\n\n')
		return
	}

	if sym.kind == .map {
		info := sym.info as ast.MapInfo
		val_type_str := g.typ(info.val_type)
		val_str := g.get_str_fun(info.val_type)

		g.fun_decls_out.write('string ${fname}(${sname} m);\n')

		// Only the stable map API is used: Map_keys returns the keys in insertion order
		g.auto_funs_out.write('string ${fname}(${sname} m) {
	Array_string keys = Map_keys(m);
	strings__Builder b = strings__new_builder(100);
	strings__Builder_write_u8(&b, \'{\');
	for (int i = 0; i < keys.length; i++) {
		string key = *(string*)Array_get(keys, i);
		strings__Builder_write_u8(&b, \'\\\'\');
		strings__Builder_write(&b, key);
		strings__Builder_write(&b, from_c_string("\': "));
		string val = ${val_str}(*(${val_type_str}*)map_get(&m, key));
		strings__Builder_write(&b, val);
		if (i < keys.length - 1) {
			strings__Builder_write(&b, from_c_string(", "));
		}
	}
	strings__Builder_write_u8(&b, \'}\');
	return strings__Builder_str(&b);
}\n\n')
		return
	}

	if sym.kind == .alias_type {
		par_fun_name := g.get_str_fun(sym.parent)

		g.fun_decls_out.write('string ${fname}(${sname} it);\n')
		g.auto_funs_out.write('string ${fname}(${sname} it) {
	return ${par_fun_name}(it);
}\n\n')
		return
	}

	if sym.kind == .result and sym.parent != ast.VOID_TYPE {
		par_fun_name := g.get_str_fun(sym.parent)
		rname := g.typ(typ)

		g.fun_decls_out.write('string ${fname}(${rname} it);\n')
		g.auto_funs_out.write('string ${fname}(${rname} it) {
	return ${par_fun_name}(it.data);
}\n\n')
		return
	}

	errors.generic_error('cannot convert ${sym.mix_name} to string')
	exit(1)
}
