package c

import bait.ast

fun (g Gen) concrete_sym(typ ast.Type) ast.TypeSymbol {
	return g.table.get_sym(g.concrete_type(typ))
}

fun (mut g Gen) typ(typ ast.Type) string {
	conc := g.concrete_type(typ)
	sym := g.table.get_sym(conc)
	if sym.kind == .result {
		return g.result_name(sym.parent)
	}

	g.type_def(sym)
	name := if sym.kind == .fun_ { fun_type_name(sym) } else { c_name(sym.mix_name.replace('C.', '')) }
	ptrs := '*'.repeat(conc.get_nr_amp())
	prefix := if sym.kind == .enum_ { 'enum ' } else { '' }
	return prefix + name + ptrs
}

// The C name of the typedef of a function type. Anonymous function types are named
// after their signature, so the name is sanitised to be a valid identifier.
fun fun_type_name(sym ast.TypeSymbol) string {
	return c_esc(sym.mix_name).replace('&', 'ptr_').replace(' ', '_').replace('(', '_').replace(')', '_').replace(',', '')
}

// Values of bait enums are prefixed with the enum name, so they don't clash with each other or with C identifiers.
// Values of C enums are declared by the C header and keep their names.
fun enum_val_name(enum_name string, val string) string {
	if enum_name.starts_with('C.') {
		return c_esc(val)
	}
	return c_name(enum_name) + '__' + val
}

fun (mut g Gen) write_types() {
	// Typedefs are written in dependency order, see `type_def`
	for sym in g.table.type_symbols {
		// Function types are only written when they are used, see `typ`.
		// Signatures of builtin functions can use types that are not defined in C.
		if sym.kind != .fun_ {
			g.type_def(sym)
		}
	}

	g.write_struct_bodies()
	g.write_result_types()
}

// Writes the bodies of all structs that are not written yet. Instances of generic
// structs are included, see `write_struct_body`.
fun (mut g Gen) write_struct_bodies() {
	for sym in g.table.type_symbols {
		g.write_struct_body(sym)
	}
}

// Writes the body of a struct, unless it was written before. Structs stored by
// value in a field are written first, because their size has to be known.
fun (mut g Gen) write_struct_body(sym ast.TypeSymbol) {
	if not g.is_c_struct(sym) or g.generated_struct_bodies.contains(sym.mix_name) {
		return
	}
	g.generated_struct_bodies.push(sym.mix_name)

	mut fields := ''
	for field in g.sym_fields(sym) {
		g.write_value_struct(field.typ)
		fields += '\t${g.typ(field.typ)} ${c_esc(field.name)};\n'
	}
	g.type_impls_out.write('struct ${c_esc(sym.mix_name)} {\n')
	g.type_impls_out.write(fields)
	g.type_impls_out.write('};\n')
}

// Writes the body of the struct that `typ` stores by value, directly or through aliases
fun (mut g Gen) write_value_struct(typ ast.Type) {
	if typ.get_nr_amp() > 0 {
		return
	}

	sym := g.concrete_sym(typ)
	if sym.kind == .alias_type {
		g.write_value_struct(sym.parent)
	} else {
		g.write_struct_body(sym)
	}
}

// Writes the typedef or definition of a user type, unless it was written before.
// The types it refers to are written first, so the order of the type symbols
// does not matter (e.g. an alias of a struct declared later in the file).
// Struct bodies are not written here, see `write_struct_body`.
fun (mut g Gen) type_def(sym ast.TypeSymbol) {
	if sym.mix_name.starts_with('C.') or g.generated_type_defs.contains(sym.mix_name) {
		return
	}
	g.generated_type_defs.push(sym.mix_name)

	cname := c_esc(sym.mix_name)
	if g.is_c_struct(sym) {
		// Only the forward declaration, the body is written by write_struct_body
		g.type_defs_out.write('typedef struct ${cname} ${cname};\n')
	} else if sym.kind == .sum_type {
		g.write_sum_type(sym)
	} else if sym.info is ast.ArrayInfo {
		g.type_defs_out.write('typedef Array ${cname};\n')
	} else if sym.info is ast.MapInfo {
		g.type_defs_out.write('typedef Map ${cname};\n')
	} else if sym.kind == .fun_ {
		info := sym.info as ast.FunInfo
		// Parameter types are written first, so that the typedef can refer to them
		ret := g.typ(info.return_type)
		mut params := []string
		for param in info.param_types {
			params.push(g.typ(param))
		}
		param_str := if params.length == 0 { 'void' } else { params.join(', ') }
		g.type_defs_out.write('typedef ${ret} (*${fun_type_name(sym)})(${param_str});\n')
	} else if sym.kind == .alias_type or sym.kind == .number {
		parent := g.typ(sym.parent)
		g.type_defs_out.write('typedef ${parent} ${cname};\n')
	}
}

// Enum definitions are written from their declarations, because `ast.EnumInfo` only stores the names of the values.
fun (mut g Gen) write_enum_types(files []ast.File) {
	for file in files {
		for stmt in file.stmts {
			if stmt is ast.EnumDecl {
				g.write_enum(stmt)
			}
		}
	}
}

fun (mut g Gen) write_enum(node ast.EnumDecl) {
	if node.lang != .bait {
		return
	}

	g.type_defs_out.write('enum ${c_esc(node.name)} {\n')
	for field in node.fields {
		// The checker has filled in the values of all fields
		val := (field.expr as ast.IntegerLiteral).val
		g.type_defs_out.write('\t${enum_val_name(node.name, field.name)} = ${val},\n')
	}
	g.type_defs_out.write('};\n')
}
