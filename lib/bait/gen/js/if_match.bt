package js

import bait.ast

fun (mut g Gen) if_match(node ast.IfMatch){
	if node.is_comptime {
		if node.ct_eval_branch >= 0 {
			g.stmts(node.branches[node.ct_eval_branch].stmts)
		}
		return
	}

	tmp := g.new_temp_var()
	mut cut := ''
	if node.is_expr {
		cut = g.cut_back_to(g.stmt_offsets.last()).trim_left('\t')
		g.empty_line = true
		g.writeln('let ${tmp} = undefined')
	}

	// Read a boxed match value only once, instead of once per branch condition
	cache_name := g.match_ref_var(node)
	mut cache_tmp := ''
	if cache_name.length > 0 {
		cache_tmp = g.new_temp_var()
		g.writeln('const ${cache_tmp} = ${js_esc(cache_name)}.$v')
	}

	for i, b in node.branches {
		if i > 0 {
			g.write("} else ")
		}
		if node.has_else and i == node.branches.length - 1 {
			g.writeln("{")
		} else {
			g.write("if (")
			// Only the conditions use the cached value, as the branches may assign the variable
			old_name := g.match_cache_name
			old_tmp := g.match_cache_tmp
			g.match_cache_name = cache_name
			g.match_cache_tmp = cache_tmp
			g.expr(b.cond)
			g.match_cache_name = old_name
			g.match_cache_tmp = old_tmp
			g.writeln(") {")
		}

		branch_start := g.out.length
		g.stmts(b.stmts)

		if node.is_expr {
			if g.empty_line {
				_ = g.cut_before(`\n`)
			}
			last_line_cut := g.cut_before_any('\n\t')

			branch_cut := g.cut_back_to(branch_start).trim_right('\n\t')
			if branch_cut.length > 0 {
				g.writeln(branch_cut)
			}

			g.writeln('\t${tmp} = ${last_line_cut}')
		}
	}
	g.writeln('}')
	g.save_stmt_offset()

	if node.is_expr {
		g.write(cut)
		g.write(tmp)
	}
}

// The `mut` param or `for mut` value matched by `node`, if it is a box. Otherwise an empty string.
fun (g Gen) match_ref_var(node ast.IfMatch) string {
	if not node.is_match or node.branches.length == 0 or not (node.branches[0].cond is ast.InfixExpr) {
		return ''
	}
	// Multiple conditions in a branch are chained with `or`
	mut cond := node.branches[0].cond as ast.InfixExpr
	for cond.op == .key_or and cond.left is ast.InfixExpr {
		cond = cond.left as ast.InfixExpr
	}
	if cond.left is ast.Ident {
		ident := cond.left as ast.Ident
		if ident.pkg.length == 0 and g.ref_vars.contains(ident.name) {
			return ident.name
		}
	}
	return ''
}
