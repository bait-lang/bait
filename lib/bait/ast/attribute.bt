package ast

import bait.token

pub struct Attribute{
	pub name string
	pub value string
	pub pos token.Pos
}

// Result of failed attribute lookups. Shared, so it must not be modified
const NO_ATTR := Attribute{}

pub fun (attrs []Attribute) has(name string) bool {
	return attrs.find_attr(name).name.length > 0
}

pub fun (attrs []Attribute) find_attr(name string) Attribute {
	for attr in attrs {
		if attr.name == name {
			return attr
		}
	}
	return NO_ATTR
}
