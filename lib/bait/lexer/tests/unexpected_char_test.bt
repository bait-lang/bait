import bait.lexer
import bait.token

fun test_unexpected_char() {
	text := '// first line
const €'

	mut l := lexer.Lexer{}
	l.init(text, .discard)
	_ = l.next()

	assert l.next() == .error
	assert l.val() == 'unexpected char € [L0001]'
	assert l.pos() == token.Pos{
		line = 2
		col = 7
	}
}

fun test_unexpected_char_multi_unit() {
	mut l := lexer.Lexer{}
	l.init('ä x', .discard)

	assert l.next() == .error
	assert l.val() == 'unexpected char ä [L0001]'
	assert l.next() == .name
	assert l.val() == 'x'
}
