package context

import bait.ast

pub struct Scope {
	pub mut parent &Scope
	pub mut objects map[string]ScopeObject
	pub mut redefined_syms []string
	pub is_local bool // Inside a function, not a file or package scope
	global is_closure bool // Outermost scope of an anonymous function
}

pub struct ScopeObject{
	pub mut kind ObjectKind
	global typ ast.Type
	pub smartcast_from ast.Type // Sum type of a smartcasted variable
	pub mut is_pub bool
	pub mut is_mut bool
	pub mut pkg string // TODO SCOPES move this into Scope (requires multi return)
	global expr ast.Expr := ast.Void{} // const / static: resolve type on use

	// Only for functions (Note: will be cleaned up in the refactor to use sumtypes)
	pub noreturn bool
	pub return_type ast.Type
	pub params []ast.Param
	pub attrs []ast.Attribute
	pub generic_names []string
	pub key string
}

pub enum ObjectKind {
	unknown
	variable
	constant
	function
	package_
	label
	static_
	type_
}

// Result of failed lookups. Shared, so it must not be modified
const UNKNOWN_OBJECT := ScopeObject{
	kind = .unknown
}

// Register an object in the selected scope
pub fun (mut s Scope) register(name string, obj ScopeObject) {
	s.objects[name] = obj
}

// Register an object but error for duplicates
pub fun (mut s Scope) register_unique(name string, obj ScopeObject) {
	if s.is_known(name) {
		s.redefined_syms.push(name)
		return
	}

	s.objects[name] = obj
}

pub fun (s Scope) get(name string) ScopeObject {
	if s.objects.contains(name) {
		return s.objects[name]
	}
	return UNKNOWN_OBJECT
}

pub fun (s Scope) get_parent(name string) ScopeObject {
	if s.objects.contains(name) {
		return s.objects[name]
	}
	if s.parent != 0 as Scope {
		return s.parent.get_parent(name)
	}
	return UNKNOWN_OBJECT
}

// Replace the object `name` in the nearest scope that contains it
pub fun (mut s Scope) update_parent(name string, obj ScopeObject) {
	if s.objects.contains(name) {
		s.objects[name] = obj
		return
	}
	if s.parent != 0 as Scope {
		s.parent.update_parent(name, obj)
	}
}

// Whether `name` is a local of a function enclosing the anonymous function of this scope
pub fun (s Scope) is_captured(name string) bool {
	mut cur := s
	mut crossed_closure := false
	for cur.is_local {
		if cur.objects.contains(name) {
			return crossed_closure
		}
		crossed_closure = crossed_closure or cur.is_closure
		cur = cur.parent
	}
	return false
}

pub fun (mut s Scope) update_type(name string, typ ast.Type) {
	s.smartcast(name, typ, 0 as ast.Type)
}

// Narrow `name` to `typ`. `from` is the sum type unless already smartcasted in a parent scope
pub fun (mut s Scope) smartcast(name string, typ ast.Type, from ast.Type) {
	// FIXME `obj` should be a copy on js backend and below code not modify the original
	// obj.typ = typ
	// s.objects[name] = obj

	// Smarcasting requires search in parents but insert in current scope
	obj := s.get_parent(name)
	s.objects[name] = ScopeObject{
		typ = typ
		smartcast_from = if obj.smartcast_from != 0 as ast.Type { obj.smartcast_from } else { from }
		kind = obj.kind
		is_pub = obj.is_pub
		is_mut = obj.is_mut
		pkg = obj.pkg
	}
}

pub fun (s Scope) is_known(name string) bool {
	obj := s.get_parent(name)
	return obj.kind != .unknown
}

pub fun (s Scope) expect_unknown(name string) ! {
	obj := s.get_parent(name)

	if obj.kind == .unknown {
		return
	}

	if obj.kind == .package_ {
		return error("cannot shadow import `${name}`")
	}

	return error("redefinition of `${name}`")
}

pub fun (s Scope) get_unique_redefinitions() []string {
	mut unique_redefs := []string
	for name in s.redefined_syms {
		if not unique_redefs.contains(name) {
			unique_redefs.push(name)
		}
	}
	return unique_redefs
}
