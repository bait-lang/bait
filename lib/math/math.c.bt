package math

import 'math.h' as #C._

pub fun #C.pow(base f64, exponent f64) f64

pub fun #C.ceil(x f64) f64

pub fun #C.log2(x f64) f64

pub fun pow(base f64, exponent f64) f64 {
	return #C.'pow(base, exponent)' as f64
}

pub fun ceil(x f64) f64 {
	return #C.ceil(x)
}

pub fun log2(x f64) f64 {
	return #C.log2(x)
}
