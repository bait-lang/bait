package strings

type Builder := []u8

pub fun new_builder(initial_size i32) Builder {
	return []u8 as Builder
}

pub fun (mut b Builder) clear() {
	#JS.'b.data = []
	b.length = 0'
}

// Stores UTF-16 code units, like JS strings, so non-ASCII text stays intact
pub fun (mut b Builder) write(s string) {
	#JS.'for (let i = 0; i < s.length; i++) {
		b.data.push(s.str.charCodeAt(i))
	}
	b.length = b.data.length'
}

pub fun (mut b Builder) write_u8(c u8) {
	b.push(c)
}

pub fun (b Builder) at(i i32) u8 {
	return #JS.'b.data[i]' as u8
}

pub fun (b Builder) substr(start i32, end i32) string {
	return string{
		str = b.to_js_string(start, end)
		length = end - start
	}
}

pub fun (mut b Builder) truncate(n i32) {
	#JS.'b.data.length = n
	b.length = n'
}

// Returns the built string and clears the builder.
pub fun (mut b Builder) str() string {
	s := string{
		str = b.to_js_string(0, b.length)
		length = b.length
	}
	b.clear()
	return s
}

// Converts in chunks, as spreading all codes as arguments overflows the stack for large builders
fun (b Builder) to_js_string(start i32, end i32) #JS.String {
	return #JS.'(() => {
		let s = ""
		for (let i = start; i < end; i += 8192) {
			s += String.fromCharCode.apply(null, b.data.slice(i, Math.min(i + 8192, end)))
		}
		return s
	})()' as #JS.String
}
