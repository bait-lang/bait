import strings

fun test_builder() {
	mut b := strings.new_builder(50)

	b.write_u8(104 as u8)
	assert b.str() == 'h'

	b.write_u8(`e`)
	b.write('llo')
	assert b.str() == 'ello'

	b.clear()
	b.write('foo')
	mut previous := b.str()
	b.write('bar')
	assert previous == 'foo'
	assert b.str() == 'bar'

	b.clear()
	assert b.str().length == 0

	b.write('foo')
	assert b.str() == 'foo'
}
