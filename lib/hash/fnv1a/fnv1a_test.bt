import hash.fnv1a

// Empty input should return the offset constant
fun test_empty_inputs() {
	b := fnv1a.sum32([]u8)
	s := fnv1a.sum32_string('')
	assert b == s
	assert b == 2166136261

	b64 := fnv1a.sum64([]u8)
	s64 := fnv1a.sum64_string('')
	assert b64 == s64
	assert b64 == 14695981039346656037
}

fun test_fnv1a_32() {
	s := 'input'
	hash := 'f9d86f7b'

	a := fnv1a.sum32_string(s)
	b := fnv1a.sum32(s.bytes())

	assert a.hex() == hash
	assert a == b
}

fun test_fnv1a_64() {
	s := 'input'
	hash := '1ebbae8f5810b65b'

	a := fnv1a.sum64_string(s)
	b := fnv1a.sum64(s.bytes())

	assert a.hex() == hash
	assert a == b
}
