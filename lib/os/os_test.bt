import os

fun test_dir(){
	l := '/foo/bar/file'
	assert os.dir(l) == '/foo/bar'

	w := 'C:\\foo\\bar\\file'
	assert os.dir(w) == 'C:\\foo\\bar'
}

fun test_read_file() {
	content := os.read_file("${$BAITDIR}/lib/os/testdata/3_lines.txt")
	normalized := content.replace('\r\n', '\n')
	assert normalized == '1\n2\n3\n'
}

fun test_read_lines() {
	lines := os.read_lines("${$BAITDIR}/lib/os/testdata/3_lines.txt")
	assert lines.length == 3
	assert lines[1] == '2'
}

fun test_exists_dir() {
	assert os.exists_dir("${$BAITDIR}/lib")
	assert not os.exists_dir("${$BAITDIR}/README.md")
	assert not os.exists_dir('i/hope/this/never/exists/anywhere')
}

fun test_getenv_missing_returns_empty() {
	key := 'BAIT_TEST_ENV_MISSING_${$LINE}'
	assert os.getenv(key) == ''
}

fun test_setenv_getenv_roundtrip() {
	key := 'BAIT_TEST_ENV_ROUNDTRIP_${$LINE}'
	value := 'roundtrip_ok'
	os.setenv(key, value)
	assert os.getenv(key) == value
}

fun test_setenv_overwrite() {
	key := 'BAIT_TEST_ENV_OVERWRITE_${$LINE}'
	os.setenv(key, 'first')
	os.setenv(key, 'second')
	assert os.getenv(key) == 'second'
}

fun test_tmp_dir() {
	tmp := os.tmp_dir()
	assert tmp != ''
	assert os.exists_dir(tmp)
}

fun test_ls() {
	names := os.ls("${$BAITDIR}/lib/os")
	assert names.contains('os.bt')
	assert names.contains('os_test.bt')
	assert names.contains('testdata')
	for n in names {
		assert os.exists("${$BAITDIR}/lib/os/${n}")
	}
}

fun test_abs_path() {
	if os.platform() == 'windows' {
		assert os.abs_path('C:\\foo\\bar\\..\\baz\\.\\x\\') == 'C:\\foo\\baz\\x'
		assert os.abs_path('C:\\') == 'C:\\'
	} else {
		assert os.abs_path('/foo/bar/../baz/./x/') == '/foo/baz/x'
		assert os.abs_path('/') == '/'
	}

	wd := os.getwd()
	assert os.abs_path('.') == wd
	assert os.abs_path('a/b') == os.join_path(wd, ['a', 'b'])
}

fun test_is_root() {
	if os.platform() == 'windows' {
		assert os.is_root('C:')
		assert not os.is_root('C:\\foo')
	} else {
		assert os.is_root('/')
		assert not os.is_root('/foo')
	}
}

fun test_executable() {
	exe := os.executable()
	assert exe.length > 0
	assert os.exists(exe)
	assert os.resource_abs_path('x') == os.join_path(os.dir(exe), ['x'])
}

fun test_home_dir() {
	assert os.exists_dir(os.home_dir())
}

fun test_user_os_arch() {
	assert os.user_os() != 'unknown'
	assert os.arch() != 'unknown'
	assert os.platform() != ''
}

fun test_chdir_getwd() {
	old := os.getwd()
	tmp := os.abs_path(os.tmp_dir())
	os.chdir(tmp)
	assert os.getwd() == os.abs_path(tmp) or os.getwd().ends_with(os.file_name(tmp))
	os.chdir(old)
	assert os.getwd() == old
}

fun test_fs_ops() {
	base := os.join_path(os.tmp_dir(), ['bait_os_test_${$LINE}'])
	if os.exists(base) {
		os.rmdir_all(base)
	}

	nested := os.join_path(base, ['a', 'b'])
	os.mkdir_all(nested)
	assert os.exists_dir(nested)

	os.mkdir(os.join_path(base, ['c']))
	assert os.exists_dir(os.join_path(base, ['c']))

	file := os.join_path(nested, ['f.txt'])
	os.write_file(file, 'hello')
	assert os.file_mod_time(file) > 0

	// Creating symlinks on Windows may require extra privileges
	with_link := os.platform() != 'windows'
	link := os.join_path(base, ['link'])
	if with_link {
		os.symlink(file, link)
		assert os.read_file(link) == 'hello'
	}

	copy := os.join_path(os.tmp_dir(), ['bait_os_test_copy_${$LINE}'])
	if os.exists(copy) {
		os.rmdir_all(copy)
	}
	os.cp(base, copy)
	assert os.read_file(os.join_path(copy, ['a', 'b', 'f.txt'])) == 'hello'
	assert os.exists_dir(os.join_path(copy, ['c']))
	os.rmdir_all(copy)
	assert not os.exists(copy)

	if with_link {
		os.rm(link)
		assert not os.exists(link)
	}
	os.rm(file)
	assert not os.exists(file)
	os.rmdir(os.join_path(base, ['c']))
	assert not os.exists(os.join_path(base, ['c']))

	os.rmdir_all(base)
	assert not os.exists(base)
}
