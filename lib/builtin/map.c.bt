package builtin

import hash.fnv1a

const map_min_cap := 8
const map_max_load_num := 7
const map_max_load_den := 10

// A map is a handle to heap-allocated state, so all copies of a map share it (like in JS)
struct Map {
	mut s &MapState
}

struct MapState {
	mut hashes []u32
	mut used []bool
	mut keys []string
	mut order []string
	mut vals Array
	mut length i32
	mut cap i32
	mut val_size i32
	mut zero &void
}

fun map_hash(key string) u32 {
	hash := fnv1a.sum32_string(key)
	if hash == 0 {
		return 1
	}
	return hash
}

fun map_key_eq(a string, b string) bool {
	if a.length != b.length {
		return false
	}
	for i := 0; i < a.length; i += 1 {
		if a[i] != b[i] {
			return false
		}
	}
	return true
}

fun map_next_cap(min_cap i32) i32 {
	mut cap := map_min_cap
	for cap < min_cap {
		cap *= 2
	}
	return cap
}

pub fun new_map(val_size i32, min_cap i32) Map {
	// Empty maps allocate their slots on the first insert
	cap := if min_cap > 0 { map_next_cap(min_cap) } else { 0 }
	return Map{
		s = &MapState{
			hashes = []u32{length = cap}
			used = []bool{length = cap}
			keys = []string{length = cap}
			order = []string{cap = cap}
			vals = new_array(cap, cap, val_size)
			cap = cap
			val_size = val_size
			zero = #C.calloc(1, val_size) as &void
		}
	}
}

pub fun new_map_from_c(len i32, val_size i32, keys &string, vals &void) Map {
	mut m := new_map(val_size, len * 2)
	for i := 0; i < len; i += 1 {
		key := *(#C.'keys + i' as &string)
		val := #C.'vals + i * val_size' as &void
		map_set(&m, key, val)
	}
	return m
}

// The state of `m`. Maps are always created by `new_map`, a zeroed map has none.
fun map_state(m Map) &MapState {
	if m.s == 0 as &MapState {
		panic('map is not initialized')
	}
	return m.s
}

// Number of entries of `m`, used for `m.length`
pub fun map_len(m Map) i32 {
	if m.s == 0 as &MapState {
		return 0
	}
	return m.s.length
}

fun map_rehash(mut s &MapState, new_cap i32) {
	old_used := s.used
	old_keys := s.keys
	old_vals := s.vals
	old_cap := s.cap

	s.hashes = []u32{length = new_cap}
	s.used = []bool{length = new_cap}
	s.keys = []string{length = new_cap}
	s.vals = new_array(new_cap, new_cap, s.val_size)
	s.cap = new_cap

	// Reinsert the slots; the insertion order is kept in `order`
	for i := 0; i < old_cap; i += 1 {
		if old_used[i] {
			map_insert_slot(mut s, old_keys[i], old_vals.get(i))
		}
	}
}

// Write `key` and `val` to the first free slot. `key` must not be in the map yet.
fun map_insert_slot(mut s &MapState, key string, val &void) {
	hash := map_hash(key)
	mut i := (hash % (s.cap as u32)) as i32
	for s.used[i] {
		i += 1
		if i == s.cap {
			i = 0
		}
	}
	s.used[i] = true
	s.hashes[i] = hash
	s.keys[i] = key
	s.vals.set(i, val)
}

fun map_ensure_cap(mut s &MapState, min_len i32) {
	if s.cap == 0 {
		map_rehash(mut s, map_min_cap)
		return
	}

	if min_len * map_max_load_den < s.cap * map_max_load_num {
		return
	}

	map_rehash(mut s, s.cap * 2)
}

// Slot index of `key`, or -1 if it is missing
fun map_find(s &MapState, key string) i32 {
	if s.cap == 0 {
		return -1
	}

	hash := map_hash(key)
	mut i := (hash % (s.cap as u32)) as i32
	for step := 0; step < s.cap; step += 1 {
		if not s.used[i] {
			return -1
		}
		if s.hashes[i] == hash and map_key_eq(s.keys[i], key) {
			return i
		}
		i += 1
		if i == s.cap {
			i = 0
		}
	}
	return -1
}

pub fun map_contains(m &Map, key string) bool {
	if m.s == 0 as &MapState {
		return false
	}
	return map_find(m.s, key) >= 0
}

pub fun map_set(m &Map, key string, val &void) {
	mut s := map_state(*m)
	i := map_find(s, key)
	if i >= 0 {
		s.vals.set(i, val)
		return
	}

	// The load factor stays below 1, so there is always a free slot
	map_ensure_cap(mut s, s.length + 1)
	map_insert_slot(mut s, key, val)
	s.order.push(key)
	s.length += 1
}

// Pointer to the value of `key`, or to a zeroed value if it is missing
pub fun map_get(m &Map, key string) &void {
	s := map_state(*m)
	i := map_find(s, key)
	if i < 0 {
		return s.zero
	}
	return s.vals.get(i)
}

// Like `map_get`, but a missing key is inserted first. Its value is zeroed and then
// written by `init`, a C function `void (*)(void*)`, unless that is NULL.
pub fun map_get_or_init(m &Map, key string, init &void) &void {
	s := map_state(*m)
	mut i := map_find(s, key)
	if i < 0 {
		map_set(m, key, s.zero)
		i = map_find(s, key)
		val := s.vals.get(i)
		#C.'if (init) { ((void (*)(void*))init)(val); }'
	}
	return s.vals.get(i)
}

// A copy of `m` with its own state. Each copied value is passed to `clone_val`,
// a C function `void (*)(void*)` that copies it in place, unless that is NULL.
pub fun map_clone(m Map, clone_val &void) Map {
	if m.s == 0 as &MapState {
		return m
	}

	mut res := new_map(m.s.val_size, m.s.length * 2)
	for key in m.s.order {
		map_set(&res, key, map_get(&m, key))
		if clone_val != 0 as &void {
			val := map_get(&res, key)
			#C.'((void (*)(void*))clone_val)(val);'
		}
	}
	return res
}

pub fun (m Map) keys() []string {
	if m.s == 0 as &MapState {
		return []string
	}
	return m.s.order.copy()
}

pub fun (m Map) contains(key string) bool {
	return map_contains(&m, key)
}

pub fun (m Map) values() []any {
	s := map_state(m)
	res := new_array(s.order.length, s.order.length, s.val_size)
	for i, key in s.order {
		res.set(i, map_get(&m, key))
	}
	return #C.'res' as []any
}

pub fun (mut m Map) clear() {
	if m.s == 0 as &MapState {
		return
	}
	// Clear the shared state in place, so all copies see it
	mut s := m.s
	s.hashes = []u32
	s.used = []bool
	s.keys = []string
	s.order = []string
	s.vals = new_array(0, 0, s.val_size)
	s.length = 0
	s.cap = 0
}
