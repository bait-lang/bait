fun test_trim() {
	mut a := [1, 2, 3]
	a.trim(2)
	assert a == [1, 2]
	assert a.length == 2
}

fun test_delete() {
	mut a := [1, 2, 3, 4]
	a.delete(1)
	assert a == [1, 3, 4]
	assert a.length == 3
	a.delete(2)
	assert a == [1, 3]
	a.delete(0)
	assert a == [3]
	a.delete(0)
	assert a.length == 0

	mut s := ['a', 'b', 'c']
	s.delete(0)
	assert s == ['b', 'c']
}

fun test_index_and_index_last() {
	nums := [1, 2, 1, 2]
	assert nums.index(1) == 0
	assert nums.index_last(1) == 2

	strings := ['a', 'b', 'c', 'c']
	assert strings.index('c') == 2
	assert strings.index_last('c') == 3
}

fun test_copy() {
	mut a := [1, 2, 3]
	b := a.copy()
	a[0] = 9
	assert a == [9, 2, 3]
	assert b == [1, 2, 3]
}

fun test_last() {
	nums := [1, 2, 3]
	assert nums.last() == 3

	parts := 'a.b.c'.split('.')
	mut last := parts.last()
	assert last == 'c'
	last = 'd'
	assert last == 'd'
}

fun test_insert() {
	mut a := [1, 3, 4]
	a.insert(1, 2)
	assert a == [1, 2, 3, 4]
	a.insert(0, 0)
	assert a == [0, 1, 2, 3, 4]
	a.insert(a.length, 5)
	assert a == [0, 1, 2, 3, 4, 5]
	assert a.length == 6

	mut empty := []i32{}
	empty.insert(0, 7)
	assert empty == [7]

	mut s := ['b', 'd']
	s.insert(0, 'a')
	s.insert(2, 'c')
	assert s == ['a', 'b', 'c', 'd']
}

fun test_insert_grows_capacity() {
	mut a := []i32{}
	for i := 0; i < 100; i += 1 {
		a.insert(0, i)
	}
	assert a.length == 100
	assert a[0] == 99
	assert a[99] == 0
}
