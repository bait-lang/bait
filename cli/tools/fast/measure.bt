package main

import os
import time

const MEM_JS := os.join_path($DIR, ['mem.js'])
const RSS_PREFIX := 'FAST_MAXRSS_KB='

struct Measurer {
	// Separate bait checkout that is measured
	dir string
	// Compiler used to bootstrap each commit
	stable string
	runs i32
}

// Check out a commit, bootstrap it and measure its self-compilation
fun (m Measurer) measure(hash string) Row {
	mut row := Row{
		hash = hash
		date = git_out(m.dir, 'log -1 --format=%cs ${hash}')
		subject = git_out(m.dir, 'log -1 --format=%s ${hash}')
	}

	if git(m.dir, 'checkout --quiet --force --detach ${hash}') != 0 or git(m.dir, 'clean --quiet -fdx') != 0 {
		eprintln('  failed to check out ${hash}')
		return row
	}

	m.bootstrap() or {
		eprintln('  ${err}')
		return row
	}

	out := os.join_path(os.tmp_dir(), ['fast_out.js'])
	for i := 0; i < m.runs; i += 1 {
		run := m.run_once(out) or {
			eprintln('  ${err}')
			return Row{
				hash = row.hash
				date = row.date
				subject = row.subject
			}
		}
		row.total = min(row.total, run.total)
		row.parse = min(row.parse, run.parse)
		row.depgraph = min(row.depgraph, run.depgraph)
		row.check = min(row.check, run.check)
		row.transform = min(row.transform, run.transform)
		row.gen = min(row.gen, run.gen)
		row.max_rss_kb = min(row.max_rss_kb, run.max_rss_kb)
	}

	row.out_lines = os.read_lines(out).length
	row.src_lines = source_lines(m.dir)
	os.rm(out)
	return row
}

// Build fast.js in two stages, so the measured compiler is generated by itself.
// The compiler has to be inside the checkout, so it picks up the right `lib/`
fun (m Measurer) bootstrap() ! {
	os.cp(m.stable, os.join_path(m.dir, ['fast0.js']))
	if m.sh('bun fast0.js cli/bait.bt -o fast1.js').code != 0 {
		return error('stable compiler failed to build this commit')
	}
	res := m.sh('bun fast1.js cli/bait.bt -o fast.js')
	if res.code != 0 {
		return error('commit failed to compile itself: ${error_line(res.stderr)}')
	}
}

fun (m Measurer) run_once(out string) !Row {
	mut sw := time.Stopwatch{}
	sw.restart()
	res := m.sh('bun --preload ${MEM_JS} fast.js --timings cli/bait.bt -o ${out}')
	sw.stop()

	if res.code != 0 {
		return error('measurement run failed: ${error_line(res.stderr)}')
	}

	mut run := Row{
		total = sw.elapsed() as i32
	}
	for line in res.stdout.split_lines() {
		val := line.substr(line.index(': ') + 2, line.length).trim_right('ms').toI32()
		if line.starts_with('PARSE: ') {
			run.parse = val
		} else if line.starts_with('DEPGRAPH: ') {
			run.depgraph = val
		} else if line.starts_with('CHECK: ') {
			run.check = val
		} else if line.starts_with('TRANSFORM: ') {
			run.transform = val
		} else if line.starts_with('GEN: ') {
			run.gen = val
		}
	}
	for line in res.stderr.split_lines() {
		if line.starts_with(RSS_PREFIX) {
			run.max_rss_kb = line.substr(RSS_PREFIX.length, line.length).toI32()
		}
	}
	return run
}

fun (m Measurer) sh(cmd string) os.CmdRes {
	return os.exec('cd "${m.dir}" && ${cmd}')
}

// Pick the most useful line of a JS stack trace or compiler error output
fun error_line(stderr string) string {
	lines := stderr.trim_space().split_lines()
	for line in lines {
		if line.contains('Error') or line.contains('error') {
			return line.trim_space()
		}
	}
	if lines.length == 0 {
		return ''
	}
	return lines[lines.length - 1]
}

// Minimum of two values where -1 means missing
fun min(a i32, b i32) i32 {
	if a < 0 or (b >= 0 and b < a) {
		return b
	}
	return a
}

// Count the lines of all Bait files compiled for the JS backend,
// starting at cli/bait.bt and following imports
fun source_lines(dir string) i32 {
	mut pkgs := ['builtin']
	mut total := scan_file(os.join_path(dir, ['cli', 'bait.bt']), mut pkgs)
	for i := 0; i < pkgs.length; i += 1 {
		pkg_dir := os.join_path(dir, ['lib', pkgs[i].replace('.', '/')])
		if not os.exists_dir(pkg_dir) {
			continue
		}
		for f in os.ls(pkg_dir) {
			if f.ends_with('.bt') and not f.ends_with('_test.bt') and not f.ends_with('.c.bt') {
				total += scan_file(os.join_path(pkg_dir, [f]), mut pkgs)
			}
		}
	}
	return total
}

fun scan_file(path string, mut pkgs []string) i32 {
	lines := os.read_lines(path)
	for line in lines {
		// Skip `import 'x' as #JS.x`
		if not line.starts_with('import ') or line.starts_with("import '") {
			continue
		}
		name := line.substr(7, line.length).trim_space().all_before(' ')
		if not pkgs.contains(name) {
			pkgs.push(name)
		}
	}
	return lines.length
}
