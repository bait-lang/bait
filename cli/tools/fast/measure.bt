package main

import os
import time

const MEM_JS := os.join_path($DIR, ['mem.js'])
const RSS_JS := os.join_path($DIR, ['rss.js'])
const RSS_PREFIX := 'FAST_MAXRSS_KB='

struct Measurer {
	// Separate bait checkout that is measured
	dir string
	// Compiler used to bootstrap each commit
	stable string
	runs i32
}

// Timings and memory of a single compiler run
struct Run {
	mut total i32 := -1
	mut parse i32 := -1
	mut depgraph i32 := -1
	mut check i32 := -1
	mut transform i32 := -1
	mut gen i32 := -1
	mut max_rss_kb i32 := -1
}

// Keep the minimum of each value
fun (mut r Run) merge(o Run) {
	r.total = min(r.total, o.total)
	r.parse = min(r.parse, o.parse)
	r.depgraph = min(r.depgraph, o.depgraph)
	r.check = min(r.check, o.check)
	r.transform = min(r.transform, o.transform)
	r.gen = min(r.gen, o.gen)
	r.max_rss_kb = min(r.max_rss_kb, o.max_rss_kb)
}

// Check out a commit, bootstrap it and measure its self-compilation.
// The JS compiler compiles itself to JS, the native compiler built by the C backend compiles itself to C
fun (m Measurer) measure(hash string) Row {
	mut row := Row{
		hash = hash
		date = git_out(m.dir, 'log -1 --format=%cs ${hash}')
		subject = git_out(m.dir, 'log -1 --format=%s ${hash}')
	}

	if git(m.dir, 'checkout --quiet --force --detach ${hash}') != 0 or git(m.dir, 'clean --quiet -fdx') != 0 {
		eprintln('  failed to check out ${hash}')
		return row
	}

	m.bootstrap() or {
		eprintln('  ${err}')
		return row
	}

	out := os.join_path(os.tmp_dir(), ['fast_out.js'])
	js := m.runs_of('bun --preload ${MEM_JS} fast.js --timings cli/bait.bt -o ${out}') or {
		eprintln('  JS: ${err}')
		os.rm(out)
		return row
	}
	row.total = js.total
	row.parse = js.parse
	row.depgraph = js.depgraph
	row.check = js.check
	row.transform = js.transform
	row.gen = js.gen
	row.max_rss_kb = js.max_rss_kb
	row.out_lines = os.read_lines(out).length
	row.out_bytes = file_size(out)
	row.src_lines = source_lines(m.dir, 'js')
	os.rm(out)

	// Older commits can't compile themselves with the C backend. Keep the JS results anyway
	m.measure_c(mut row)
	return row
}

fun (m Measurer) measure_c(mut row Row) {
	res := m.sh('bun fast.js -b c cli/bait.bt -o fastc')
	if res.code != 0 {
		eprintln('  C: failed to build the native compiler: ${error_line(res.stderr + res.stdout)}')
		return
	}

	out := os.join_path(os.tmp_dir(), ['fast_out.c'])
	c := m.runs_of('bun ${RSS_JS} ./fastc -b c --timings cli/bait.bt -o ${out}') or {
		eprintln('  C: ${err}')
		os.rm(out)
		return
	}
	row.c_total = c.total
	row.c_parse = c.parse
	row.c_check = c.check
	row.c_transform = c.transform
	row.c_gen = c.gen
	row.c_max_rss_kb = c.max_rss_kb
	row.c_out_lines = os.read_lines(out).length
	row.c_out_bytes = file_size(out)
	row.c_src_lines = source_lines(m.dir, 'c')
	os.rm(out)
}

// Build fast.js in two stages, so the measured compiler is generated by itself.
// The compiler has to be inside the checkout, so it picks up the right `lib/`
fun (m Measurer) bootstrap() ! {
	os.cp(m.stable, os.join_path(m.dir, ['fast0.js']))
	if m.sh('bun fast0.js cli/bait.bt -o fast1.js').code != 0 {
		return error('stable compiler failed to build this commit')
	}
	res := m.sh('bun fast1.js cli/bait.bt -o fast.js')
	if res.code != 0 {
		return error('commit failed to compile itself: ${error_line(res.stderr)}')
	}
}

// Run a command `m.runs` times and keep the minimum of each value
fun (m Measurer) runs_of(cmd string) !Run {
	mut best := Run{}
	for i := 0; i < m.runs; i += 1 {
		run := m.run_once(cmd)!
		best.merge(run)
	}
	return best
}

fun (m Measurer) run_once(cmd string) !Run {
	mut sw := time.Stopwatch{}
	sw.restart()
	res := m.sh(cmd)
	sw.stop()

	if res.code != 0 {
		return error('measurement run failed: ${error_line(res.stderr)}')
	}

	mut run := Run{
		total = sw.elapsed() as i32
	}
	for line in res.stdout.split_lines() {
		val := line.substr(line.index(': ') + 2, line.length).trim_right('ms').toI32()
		if line.starts_with('PARSE: ') {
			run.parse = val
		} else if line.starts_with('DEPGRAPH: ') {
			run.depgraph = val
		} else if line.starts_with('CHECK: ') {
			run.check = val
		} else if line.starts_with('TRANSFORM: ') {
			run.transform = val
		} else if line.starts_with('GEN: ') {
			run.gen = val
		}
	}
	for line in res.stderr.split_lines() {
		if line.starts_with(RSS_PREFIX) {
			run.max_rss_kb = line.substr(RSS_PREFIX.length, line.length).toI32()
		}
	}
	return run
}

fun (m Measurer) sh(cmd string) os.CmdRes {
	return os.exec('cd "${m.dir}" && ${cmd}')
}

// Pick the most useful line of a JS stack trace or compiler error output
fun error_line(stderr string) string {
	lines := stderr.trim_space().split_lines()
	for line in lines {
		if line.contains('Error') or line.contains('error') {
			return line.trim_space()
		}
	}
	if lines.length == 0 {
		return ''
	}
	return lines[lines.length - 1]
}

// Minimum of two values where -1 means missing
fun min(a i32, b i32) i32 {
	if a < 0 or (b >= 0 and b < a) {
		return b
	}
	return a
}

fun file_size(path string) i32 {
	res := os.exec('wc -c < "${path}"')
	if res.code != 0 {
		return -1
	}
	return res.stdout.trim_space().toI32()
}

// Count the lines of all Bait files compiled for a backend (`js` or `c`),
// starting at cli/bait.bt and following imports
fun source_lines(dir string, backend string) i32 {
	other := if backend == 'c' { '.js.bt' } else { '.c.bt' }
	mut pkgs := ['builtin']
	mut total := scan_file(os.join_path(dir, ['cli', 'bait.bt']), mut pkgs)
	for i := 0; i < pkgs.length; i += 1 {
		pkg_dir := os.join_path(dir, ['lib', pkgs[i].replace('.', '/')])
		if not os.exists_dir(pkg_dir) {
			continue
		}
		for f in os.ls(pkg_dir) {
			if f.ends_with('.bt') and not f.ends_with('_test.bt') and not f.ends_with(other) {
				total += scan_file(os.join_path(pkg_dir, [f]), mut pkgs)
			}
		}
	}
	return total
}

fun scan_file(path string, mut pkgs []string) i32 {
	lines := os.read_lines(path)
	for line in lines {
		// Skip `import 'x' as #JS.x`
		if not line.starts_with('import ') or line.starts_with("import '") {
			continue
		}
		name := line.substr(7, line.length).trim_space().all_before(' ')
		if not pkgs.contains(name) {
			pkgs.push(name)
		}
	}
	return lines.length
}
