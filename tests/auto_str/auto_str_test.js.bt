struct FloatBar {
	f f64
}

// TODO C fix float precision: f64.str() prints with %.17g, so 3.14 becomes 3.1400000000000001
fun test_float_struct() {
	b := FloatBar {
		f = 3.14
	}
	assert b.str() == 'FloatBar{
  f = 3.14
}'
}
