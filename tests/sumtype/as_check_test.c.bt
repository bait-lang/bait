import bait.util.exe
import os

const TMP := os.join_path(os.tmp_dir(), ['bait_sumtype_as_test'])

// Runs `code` as separate program, since a panic would stop the tests.
// JS does not check `as` on sum types, so this is C only.
fun run_prog(name string, code string) os.CmdRes {
	os.mkdir_all(TMP)
	path := os.join_path(TMP, ['${name}.bt'])
	os.write_file(path, 'type Value := i32 | string\n\nfun main() {\n\t${code}\n}\n')
	return os.exec('${exe.bait_cmd()} --nocolor -b c run ${path}')
}

fun test_wrong_as_cast_panics() {
	res := run_prog('wrong', "x := 'hi' as Value\n\tprintln(x as i32)")
	assert res.code != 0
	assert res.stderr.contains('invalid sum type cast: expected i32, got string')
}

fun test_correct_as_cast_works() {
	res := run_prog('ok', "x := 'hi' as Value\n\tprintln(x as string)")
	assert res.code == 0
	assert res.stdout.contains('hi')
}
