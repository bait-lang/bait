// JS strings are UTF-16 code units
fun test_literal_keeps_non_ascii() {
	s := '€ ü 日本'
	assert s.length == 6
	assert #JS.'s.str.charCodeAt(0)' as i32 == 0x20AC
	assert #JS.'s.str.charCodeAt(4)' as i32 == 0x65E5
}

fun test_interpolation_keeps_non_ascii() {
	x := 'ü'
	s := '€${x}日'
	assert s.length == 3
	assert #JS.'s.str.charCodeAt(0)' as i32 == 0x20AC
	assert #JS.'s.str.charCodeAt(2)' as i32 == 0x65E5
}

// Code units above 0xFF must not be truncated into ASCII chars
fun test_index_above_latin1() {
	s := 'ä€😀'
	assert s[0] == 0xE4
	assert s[1] == 0xFF
	assert s[2] == 0xFF
	assert s[3] == 0xFF
}
