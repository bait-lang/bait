fun test_simple_interpolation(){
	greet := 'hello'
	to := 'world'
	assert '${greet} ${to}' == 'hello world'
}

fun test_escape_backtick(){
	x := 'a'
	assert '` ${x}' == '` a'
}

fun test_escape_dollar() {
	x := 'a'
	assert '\${x} ${x}' == '\${x} a'
}

fun test_octal_escape() {
	x := 'abc'
	s := '\033[0;31m${x}\033[0m'
	assert s.length == 14
	assert s[0] == 27
}
