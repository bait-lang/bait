struct Point {
	mut x i32
	mut ys []i32
}

struct A {}

struct B {
	mut v i32
}

type AB := A | B

fun inc(mut n i32) {
	n += 1
}

fun inc_twice(mut n i32) {
	inc(mut n)
	inc(mut n)
}

fun grow(mut a []i32) {
	a.push(a.length)
}

fun replace(mut p Point) {
	p = Point{
		x = 42
	}
}

fun exclaim(mut s string) {
	s += '!'
}

fun set_b(mut s AB) {
	if s is B {
		s.v = 3
	}
}

fun set_generic[T](mut a T, b T) {
	a = b
}

fun set_and_get(mut n i32) i32 {
	n = 100
	return n
}

fun (p Point) add_to(mut n i32) {
	n += p.x
}

fun test_number() {
	mut n := 0
	inc(mut n)
	assert n == 1
	inc_twice(mut n)
	assert n == 3
	assert set_and_get(mut n) == 100
	assert n == 100
}

fun test_array() {
	mut a := []i32
	grow(mut a)
	grow(mut a)
	assert a == [0, 1]
}

fun test_struct() {
	mut p := Point{}
	replace(mut p)
	assert p.x == 42
}

fun test_string() {
	mut s := 'hi'
	exclaim(mut s)
	assert s == 'hi!'
}

fun test_sumtype() {
	mut s := B{} as AB
	set_b(mut s)
	assert (s as B).v == 3
}

fun test_generic() {
	mut n := 1
	set_generic(mut n, 9)
	assert n == 9
	mut s := 'a'
	set_generic(mut s, 'b')
	assert s == 'b'
}

fun test_method_param() {
	p := Point{
		x = 5
	}
	mut n := 1
	p.add_to(mut n)
	assert n == 6
}

fun test_field_and_element() {
	mut p := Point{}
	inc(mut p.x)
	assert p.x == 1
	grow(mut p.ys)
	assert p.ys == [0]

	mut arr := [1, 2, 3]
	inc(mut arr[1])
	assert arr == [1, 3, 3]

	mut m := map[string]i32
	inc(mut m['a'])
	assert m['a'] == 1
}
