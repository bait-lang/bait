struct Point {
	mut x i32
}

fun (p Point) get_x() i32 {
	return p.x
}

fun (mut p Point) inc() {
	p.x += 1
}

fun test_pointer_deref() {
	n := 42
	nptr := &n
	assert typeof(nptr) == '*i32'

	n2 := *nptr
	assert typeof(n2) == 'i32'
	assert n2 == n
}

fun test_struct_pointer() {
	mut p := Point{
		x = 1
	}
	mut ptr := &p
	assert typeof(ptr) == '*Point'
	assert ptr.x == 1
	assert ptr.get_x() == 1

	ptr.inc()
	assert p.x == 2

	ptr.x = 5
	assert p.x == 5

	copy := *ptr
	assert typeof(copy) == 'Point'
	assert copy.x == 5
}

fun test_pointer_rebind() {
	a := Point{
		x = 1
	}
	b := Point{
		x = 2
	}
	mut ptr := &a
	ptr = &b
	assert ptr.x == 2
	assert a.x == 1
}

fun test_pointer_to_pointer() {
	n := 1
	nptr := &n
	nptr2 := &nptr
	assert typeof(nptr2) == '**i32'
}

fun test_pointer_str() {
	p := Point{
		x = 3
	}
	ptr := &p
	assert ptr.str() == p.str()
	assert '${ptr}' == '${p}'
}

fun test_number_reference() {
	mut n := 1
	r := &n
	n = 5
	assert *r == 5
}

fun test_pointer_to_pointer_deref() {
	n := 3
	nptr := &n
	nptr2 := &nptr
	assert **nptr2 == 3
}

fun set_x(mut p &Point, x i32) {
	p.x = x
}

fun test_reference_param() {
	mut a := Point{
		x = 1
	}
	mut r := &a
	set_x(mut r, 2)
	assert a.x == 2
}
