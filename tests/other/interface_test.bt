interface Sensor {
	unit string
	interval f64
	read_val() f64
}

struct TemperatureSensor implements Sensor {
	unit string := '°C'
	interval f64
}

fun (t TemperatureSensor) read_val() f64 {
	return 21.5
}

struct PressureSensor implements Sensor {
	unit string := 'hPa'
	interval f64
}

fun (p PressureSensor) read_val() f64 {
	return 1013.25
}

fun test_interfaces() {
	ts := TemperatureSensor{
		interval = 1.0
	}
	ps := PressureSensor{
		interval = 2.5
	}

	mut wheater_sensors := []Sensor{}
	wheater_sensors.push(ts)
	wheater_sensors.push(ps)

	assert wheater_sensors[0].read_val() == 21.5
	assert wheater_sensors[1].read_val() == 1013.25
}
