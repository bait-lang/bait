import bait.test_pkgs.structs

enum Color {
	red
	green
}

struct Numbers {
	mut signed i64 := 5
	mut unsigned u64 := 6
	negative i64 := -7
	hex i64 := 0x10
	sum i64 := 1 + 2
	small u8 := 3
}

fun test_number_literals() {
	mut n := Numbers{}
	assert n.signed == 5
	assert n.unsigned == 6
	assert n.negative == -7
	assert n.hex == 16
	assert n.sum == 3
	assert n.small == 3

	n.signed += 1 as i64
	n.unsigned += 1 as u64
	assert n.signed == 6 as i64
	assert n.unsigned == 7 as u64
}

struct Inferred {
	color Color := .green
	list []i32 := []
}

fun test_inferred_from_field_type() {
	i := Inferred{}
	assert i.color == .green
	assert i.list.length == 0
}

fun fails() !i32 {
	return error('failed')
}

fun succeeds() !i32 {
	return 3
}

fun fails_str() !string {
	return error('failed str')
}

fun fails_i64() !i64 {
	return error('failed')
}

struct Fallbacks {
	fallback i32 := fails() or { 7 }
	value i32 := succeeds() or { 8 }
	nested i32 := (fails() or { 1 }) + 1
	from_err string := fails_str() or { err }
	big i64 := fails_i64() or { 9 }
	if_expr string := if true { 'yes' } else { 'no' }
}

fun test_or_block() {
	f := Fallbacks{}
	assert f.fallback == 7
	assert f.value == 3
	assert f.nested == 2
	assert f.from_err == 'failed str'
	assert f.big == 9
	assert f.if_expr == 'yes'
}

fun test_or_block_multiple_inits() {
	a := Fallbacks{}
	b := Fallbacks{}
	c := Fallbacks{
		fallback = 100
	}
	assert a.fallback + b.fallback + c.fallback == 114
}

fun test_or_block_in_other_package() {
	w := structs.WithFallback{}
	assert w.val == 8
}
