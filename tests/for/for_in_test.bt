fun test_array() {
	arr := [1, 2, 3]

	mut counter := 1
	for a in arr {
		assert a == counter
		counter += 1
	}

	for i, a in arr {
		assert a == i + 1
	}
}

fun test_string() {
	s := "foo"
	chars := [`f`, `o`, `o`]

	for i, c in s {
		assert c == chars[i]
	}
}

fun test_map() {
	m := map{
		"key 1": "val 1"
		"key 2": "val 2"
	}

	for k, v in m {
		assert k.length == v.length
	}
}

fun test_mutable_value() {
	mut arr := [1, 2, 3]
	for mut a in arr {
		a += 1
	}
	assert arr == [2, 3, 4]
}

struct Item {
	mut n i32
}

fun test_mutable_value_struct() {
	mut items := [Item{}, Item{}]
	for mut it in items {
		it.n = 1
	}
	assert items[1].n == 1

	for mut it in items {
		it = Item{ n = 5 }
	}
	assert items[0].n == 5
}

fun test_mutable_value_nested() {
	mut grid := [[1, 2], [3]]
	for mut row in grid {
		for mut x in row {
			x *= 10
		}
		row.push(0)
	}
	assert grid == [[10, 20, 0], [30, 0]]
}

fun test_mutable_map_value() {
	mut m := map[string]i32
	m['a'] = 1
	m['b'] = 2
	for k, mut v in m {
		v += 1
	}
	assert m['a'] == 2
	assert m['b'] == 3
}
